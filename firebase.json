{
  "hosting": {
    "public": "frontend/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/chat/**", "destination": "/chat.html" },
      { "source": "/analysis/**", "destination": "/analysis/new.html" }
    ]
  }
}
