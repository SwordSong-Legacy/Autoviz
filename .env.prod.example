
# Out of Bits - Production Environment
# Generated by fastapi-fullstack v0.1.18
#
# IMPORTANT: Copy this file to .env.prod before deploying
#   cp .env.prod.example .env.prod
#
# WARNING: Never commit .env.prod to version control!

# === Container Prefix (must be unique per server) ===
CONTAINER_PREFIX=out-of-bits

# === Application ===
PROJECT_NAME=Out of Bits
ENVIRONMENT=production

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # Generate: openssl rand -base64 32
POSTGRES_DB=autoviz

# === JWT authentication (required) ===
SECRET_KEY=  # Generate a unique random value with at least 32 characters

# === OpenRouter (optional if users provide their own key) ===
OPENROUTER_API_KEY=

# === Modal Sandboxes (required) ===
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=autoviz

# === CORS (replace with the deployed frontend origin) ===
CORS_ORIGINS=["https://your-frontend.example.com"]
