# Out of Bits - local development environment
# Copy to .env and replace all marked values before starting the backend.

# Application
PROJECT_NAME=Out of Bits
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autoviz
POSTGRES_SSLMODE=

# JWT authentication (required; use a unique random value with at least 32 characters)
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# AI provider (optional when each user supplies a key in the application)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet

# Modal Sandboxes (required for feature engineering and visualization execution)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=autoviz

# Browser origins accepted by FastAPI. Pydantic accepts this JSON list syntax.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Frontend overrides (set in the frontend runtime/build environment when needed)
BACKEND_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_USE_API_PROXY=false
